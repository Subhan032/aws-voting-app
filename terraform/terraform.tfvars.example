# Example local configuration overrides
# Copy this file to terraform.tfvars for local execution
aws_profile  = "new-account"
aws_region   = "ap-southeast-2"
environment  = "dev"
project_name = "aws-voting-app"

# Network configuration overrides (optional)
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
# availability_zones = ["ap-southeast-2a", "ap-southeast-2b"]

# -----------------------------------------------------------------------------
# Amazon EKS Cluster Security & Node Group Overrides
# -----------------------------------------------------------------------------
kubernetes_version = "1.35"

# IMPORTANT: Restrict public access to your own public IP address in /32 CIDR notation.
# Replace the placeholder below (e.g. find your IP with `curl -s https://checkip.amazonaws.com`)
# with your actual IP address before running `terraform apply`.
# Never use ["0.0.0.0/0"] in production or test environments.
cluster_endpoint_public_access_cidrs = ["203.0.113.50/32"]

# Managed Node Group scaling & compute settings
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
node_disk_size      = 20
